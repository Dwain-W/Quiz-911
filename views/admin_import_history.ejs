<div class="container py-4">
  <h1 class="mb-3">Import History</h1>

  <p class="text-muted">
    Showing the last <strong>100</strong> imports. Newest first.
  </p>

  <% if (!logs || logs.length === 0) { %>
    <div class="alert alert-info">
      No imports logged yet. Try importing a lesson from the
      <a href="/admin/import">Admin Import</a> page.
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>When</th>
            <th>Lesson ID</th>
            <th>Title</th>
            <th>Topic</th>
            <th class="text-end">Questions</th>
            <th>JSON Path</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(log => { %>
            <tr>
              <td class="text-muted">
                <%= log.createdAt ? new Date(log.createdAt).toLocaleString() : '-' %>
              </td>
              <td><code><%= log.lessonSlug %></code></td>
              <td><%= log.lessonTitle || '-' %></td>
              <td class="text-muted"><%= log.topic || '-' %></td>
              <td class="text-end"><%= log.questionCount || 0 %></td>
              <td><code><%= log.jsonPath %></code></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="mt-3">
    <a href="/admin/lessons" class="btn btn-outline-secondary">Back to Lessons</a>
  </div>
</div>
