<h2 class="mb-3">Profile</h2>

<div class="row g-3">
  <div class="col-md-4">
    <div class="card p-3 h-100">
      <h5 class="mb-1"><%= user.displayName %></h5>
      <div class="text-muted mb-2"><%= user.email %></div>
      <div>XP: <strong><%= (locals?.user && locals.user.xp) || '' %></strong></div>
      <div>Streak: <strong><%= (locals?.user && locals.user.streak) || '' %></strong> days</div>
    </div>
  </div>
  <div class="col-md-8">
    <div class="card p-3 h-100">
      <h5 class="mb-3">Stats</h5>
      <div>Total attempts: <strong><%= stats.totalAttempts %></strong></div>
      <div>Correct: <strong><%= stats.correctAttempts %></strong></div>
      <div>Accuracy: <strong><%= stats.accuracy %>%</strong></div>

      <h6 class="mt-3">Per lesson</h6>
      <ul class="list-group">
        <% lessons.forEach(L => { 
          const pct = L.totalQ ? Math.round(100 * L.correctQ / L.totalQ) : 0; %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= L.title %></span>
            <span class="badge bg-secondary"><%= L.correctQ %>/<%= L.totalQ %> • <%= pct %>%</span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<div class="mt-4">
  <a class="btn btn-outline-secondary" href="/learn">← Back to Learn</a>
</div>
