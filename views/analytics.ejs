<h2 class="mb-3">Analytics: <%= lesson.title %></h2>
<table class="table table-sm">
  <thead><tr><th>#</th><th>Correct</th><th>Time (s)</th><th>Points</th></tr></thead>
  <tbody>
    <% lesson.questionIds.forEach((qid, i) => {
         const row = latest.find(x => x._id === qid)?.doc; %>
      <tr>
        <td><%= i+1 %></td>
        <td><%= row ? (row.isCorrect ? '✅' : '❌') : '—' %></td>
        <td><%= row?.timeTakenSec ?? '—' %></td>
        <td><%= row?.awardedPoints ?? '—' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<div class="mt-3">
  <a class="btn btn-outline-secondary" href="/review/<%= lesson.slug %>">Review answers</a>
</div>
