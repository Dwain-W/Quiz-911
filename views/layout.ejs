<%
  // Safe defaults so EJS never crashes if locals aren't present yet
  const APPNAME = (typeof APP_NAME !== "undefined" && APP_NAME) ? APP_NAME : "Quiz-911";
  const DISCLAIMER = (typeof APP_DISCLAIMER !== "undefined" && APP_DISCLAIMER) ? APP_DISCLAIMER : "";
  const pageTitle = (typeof title !== "undefined" && title) ? title : "";
  const currentUser = (typeof user !== "undefined") ? user : null;
%>

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= pageTitle ? `${pageTitle} · ${APPNAME}` : APPNAME %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/"><%= APPNAME %></a>

        <div class="navbar-nav">
          <a class="nav-link" href="/lessons">Procedures</a>
          <a class="nav-link" href="/review">Review</a>
          <a class="nav-link" href="/leaderboard">Leaderboard</a>
          <a class="nav-link" href="/admin/import">Admin Import</a>
        </div>

        <div class="ms-auto navbar-nav">
          <% if (currentUser) { %>
            <a class="nav-link" href="/profile"><%= currentUser.displayName || currentUser.email %></a>
          <% } else { %>
            <a class="nav-link" href="/auth/login">Login</a>
          <% } %>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <%- body %>
    </main>

    <footer class="container pb-4">
      <div class="text-muted small"><%= DISCLAIMER %></div>
    </footer>
  </body>
</html>
